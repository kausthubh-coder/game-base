// One Worker for the whole game: it serves the built game's files (dist/, made by `bun run build`). See server/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-base",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-11",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // The world server's Durable Object is gone with multiplayer. This tombstone retires its namespace and the
  // worlds stored in it on the next deploy; Cloudflare refuses a deploy that drops the class without it.
  "exports": {
    "WorldServer": { "type": "durable-object", "state": "deleted" }
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  "dev": {
    "port": 5540,
    "inspector_port": 5541
  }
}
