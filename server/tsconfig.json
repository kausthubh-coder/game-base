{
  // The world server's own type check: the Workers runtime's types and no page. A rule file that reaches
  // for `document` fails here, because the server imports the rules.
  //   bunx tsc -p server
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "strict": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["*.ts", "../src/engine/net"],
  "exclude": ["../src/engine/net/*.test.ts"]
}
