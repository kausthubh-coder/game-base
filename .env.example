# Copy to .env.local and fill in. .env.local is not in git. With none of these set the game still runs:
# everyone plays as a guest and the Account panel says sign-in is not set up.

# Convex. `bunx convex dev --once` writes these three for the deployment it is pointed at.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Clerk. `bunx clerk@latest env pull` writes these two for the linked application.
# The publishable key goes into the browser. The secret key never does: only tools and tests read it.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The secret the world server sends when it posts a world's card to Convex (convex/README.md).
# The same value is set on the Convex deployment: bunx convex env set WORLD_SERVER_SECRET=<value>
WORLD_SERVER_SECRET=
